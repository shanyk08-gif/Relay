# Configuration reference only; the local launcher does not load this file.
# Enter real values in your hosting provider's environment settings.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
RELAY_PROVIDER=gemini
GEMINI_API_KEY=

# Hosted mode only (set these in Render, never commit real secrets):
RELAY_HOSTED=1
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Render supplies RENDER_EXTERNAL_HOSTNAME; PUBLIC_ORIGIN is needed for custom domains.
# PUBLIC_ORIGIN=https://your-domain.example
